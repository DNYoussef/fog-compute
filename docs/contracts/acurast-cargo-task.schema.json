{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "acurast-cargo-task.schema.json",
  "title": "Acurast Cargo Fog Task Payload",
  "description": "Deterministic Fog Compute task envelope for the Acurast Cargo feasibility spike",
  "type": "object",
  "required": ["schema_version", "task_id", "operation", "operands"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "fog.acurast-cargo.task.v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "operation": {
      "type": "string",
      "enum": ["add", "multiply", "sum", "sha256"]
    },
    "operands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "anyOf": [
          { "type": "number" },
          { "type": "string", "minLength": 1, "maxLength": 4096 }
        ]
      }
    },
    "expected_schema_version": {
      "type": "string",
      "const": "fog.acurast-cargo.result.v1"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "created_by": { "type": "string", "maxLength": 100 },
        "source": { "type": "string", "maxLength": 100 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

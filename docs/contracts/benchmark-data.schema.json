{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "benchmark-data.schema.json",
  "title": "Benchmark Data Response",
  "description": "Canonical schema for GET /api/benchmarks/data",
  "type": "object",
  "required": ["timestamp", "latency", "throughput", "cpuUsage", "memoryUsage", "networkUtilization"],
  "properties": {
    "timestamp": { "type": "integer" },
    "latency": { "type": "number", "minimum": 0 },
    "throughput": { "type": "number", "minimum": 0 },
    "cpuUsage": { "type": "number", "minimum": 0, "maximum": 100 },
    "memoryUsage": { "type": "number", "minimum": 0, "maximum": 100 },
    "networkUtilization": { "type": "number", "minimum": 0, "maximum": 100 }
  },
  "additionalProperties": false
}

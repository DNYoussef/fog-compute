{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "betanet-status.schema.json",
  "title": "Betanet Status Response",
  "description": "Canonical schema for GET /api/betanet/status",
  "type": "object",
  "required": ["status", "nodes", "network"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["healthy", "degraded", "unavailable", "mock"]
    },
    "nodes": {
      "type": "object",
      "required": ["total", "active", "inactive"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "active": { "type": "integer", "minimum": 0 },
        "inactive": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "required": ["latency", "bandwidth", "throughput", "packetsProcessed"],
      "properties": {
        "latency": { "type": "number", "minimum": 0 },
        "bandwidth": { "type": "number", "minimum": 0 },
        "throughput": { "type": "number", "minimum": 0 },
        "packetsProcessed": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "lastUpdated": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
